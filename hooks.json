{
  "test-forge-project-detector": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/detect-project.mjs",
        "timeout": 10
      }
    ]
  },
  "test-forge-secret-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/secret-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "test-forge-activity-tracker": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/track-activity.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "test-forge-strict-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/strict-gate.mjs",
        "timeout": 10
      }
    ]
  }
}
